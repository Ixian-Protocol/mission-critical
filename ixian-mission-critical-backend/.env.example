# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME="Mission Critical Backend"
VERSION="1.0.0"
DESCRIPTION="Mission Critical is a TODO app for homelabbers. It is built with FastAPI and PostgreSQL, and features ntfy notifications for task updates."

# Environment — OpenAPI docs are only enabled when ENVIRONMENT=development
ENVIRONMENT="development"
DEBUG="True"

# CORS Origins (comma-separated; JSON array strings are also accepted)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173,http://localhost:4173,capacitor://localhost,http://localhost,https://localhost
# For direct backend calls from a LAN browser, add your frontend origin(s), OR set a regex pattern:
# BACKEND_CORS_ORIGIN_REGEX=^http://192\.168\.[0-9]+\.[0-9]+:[0-9]+
# Leave blank to disable regex matching (origins list only).

# Database (PostgreSQL)
# Change POSTGRES_PASSWORD for any shared or long-lived deploy.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# ntfy Notifications (optional - leave blank to disable)
# NTFY_URL=http://ntfy:80 for Docker Compose; use http://localhost:8082 from the host.
# NTFY_TOKEN=  # Optional: for authenticated ntfy servers
# Must match the topic shown in the app setup/settings screen (random per install).
NTFY_TOPIC=change-me-set-unique-topic
