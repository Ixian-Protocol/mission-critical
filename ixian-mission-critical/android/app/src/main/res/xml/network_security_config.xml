<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP to LAN IPs (e.g. http://192.168.x.x:3000) for homelab sync.
  Android does not treat values like "192.168.0.0" as subnets — only matching hostnames.
  See: https://developer.android.com/privacy-and-security/security-config
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
